# Public URL users open in the browser.
APP_URL=http://localhost:3000
# Random secret (openssl rand -hex 32); keep unchanged across restarts.
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Random Postgres password (openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Image tag (latest, or a release such as 0.2.0).
# S2_VERSION=latest
# Host directories for Postgres data and file storage.
POSTGRES_DATA_PATH=./data/postgres
S2_STORAGE_PATH=./data/storage
# Host loopback port.
S2_PORT=3000
# Feature flags.
SIGNUP_ENABLED=false
PASSKEY_ENABLED=true
TOTP_ENABLED=true
EMAIL_ENABLED=false
# SMTP, required when EMAIL_ENABLED=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM="S2 <noreply@example.com>"
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Daily maintenance (UTC cron).
MAINTENANCE_ENABLED=true
# TRASH_RETENTION_DAYS=30
# MAX_PAST_VERSIONS=0
# GC_GRACE_DAYS=8
# GC_BATCH_SIZE=1000
