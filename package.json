{
  "name": "s2",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:up": "DATABASE_URL=postgres://postgres:postgres@localhost:5432/s2?sslmode=disable dbmate -d ./migrations --no-dump-schema up",
    "db:drop": "DATABASE_URL=postgres://postgres:postgres@localhost:5432/s2?sslmode=disable dbmate -d ./migrations drop",
    "db:reset": "pnpm db:drop && pnpm db:up",
    "db:status": "DATABASE_URL=postgres://postgres:postgres@localhost:5432/s2?sslmode=disable dbmate -d ./migrations status",
    "db:new": "DATABASE_URL=postgres://postgres:postgres@localhost:5432/s2?sslmode=disable dbmate -d ./migrations new",
    "dev": "pnpm db:up && react-router dev --port 8888",
    "dev:fresh": "pnpm db:reset && rm -rf .dev/storage && react-router dev --port 8888",
    "migrate": "dbmate -d ./migrations --no-dump-schema up",
    "serve": "node --import tsx server/server.ts",
    "maintenance": "node --import tsx server/maintenance.ts",
    "user": "node --import tsx server/user.ts",
    "release": "release-it",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate:api-types": "openapi-typescript openapi.yaml -o app/lib/api.generated.ts",
    "check:api-types": "pnpm generate:api-types && git diff --exit-code app/lib/api.generated.ts",
    "check:rls-bypass": "scripts/check-no-rls-bypass.sh",
    "generate:auth-schema": "better-auth generate --config scripts/auth-cli-config.ts --output schema.sql -y",
    "check:auth-schema": "pnpm generate:auth-schema && git diff --exit-code schema.sql",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm check:api-types && pnpm check:rls-bypass && pnpm typecheck && pnpm test:coverage && pnpm build",
    "test": "vitest run",
    "test:all": "pnpm test:coverage && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:types": "vitest run --project types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm test:e2e:webui && pnpm test:e2e:api && pnpm test:e2e:visual && pnpm test:e2e:litmus",
    "test:e2e:webui": "e2e/docker/run.sh s2-e2e-webui test --config=e2e/playwright.config.ts",
    "test:e2e:api": "e2e/docker/run.sh s2-e2e-api test --config=e2e/playwright.api.config.ts",
    "test:e2e:visual": "e2e/docker/run.sh s2-e2e-visual test --config=e2e/playwright.visual.config.ts",
    "test:e2e:visual:update": "e2e/docker/run.sh s2-e2e-visual test --config=e2e/playwright.visual.config.ts --update-snapshots",
    "test:e2e:litmus": "e2e/docker/run.sh s2-e2e-litmus litmus",
    "prepare": "husky",
    "postinstall": "react-router typegen"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.2.2",
    "better-auth": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.0",
    "i18next": "^25.10.5",
    "lucide-react": "^0.577.0",
    "markdown-it": "^14.1.1",
    "nodemailer": "^9.0.6",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.6.3",
    "react-router": "^7.13.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "2.4.8",
    "@electric-sql/pglite": "^0.4.2",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.13.1",
    "@remix-run/node-fetch-server": "^0.13.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "dbmate": "^2.32.0",
    "happy-dom": "^20.8.4",
    "husky": "^9.1.7",
    "msw": "^2.12.14",
    "openapi-typescript": "^7.13.0",
    "release-it": "21.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
